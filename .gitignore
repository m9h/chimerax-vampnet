# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.whl

# Bundle build outputs
src/version.py

# MD data / generated ensembles — too large for git, live on /data.
# Unanchored on purpose: `modal run md/<adapter>.py --out foo.npz` drops
# ensembles into the repo root, which the old md/-only rules missed.
*.npz
*.dcd
*.xtc
*.chk
md/*.pdb

# Docker container runtime cache (CUDA shader cache etc)
md/.containerhome/
.containerhome/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
