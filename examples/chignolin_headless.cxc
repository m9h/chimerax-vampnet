# Headless integration test for the chimerax-vampnet bundle.
# Runs the full analysis pipeline non-interactively and exits.
#
# Run inside ChimeraX:
#   chimerax --nogui --silent --exit --cmd "open chignolin_headless.cxc"

open /data/datasets/chimerax-vampnet/chignolin_modal/chignolin/equilibrated.pdb

vampnet load_ensemble md /data/datasets/chimerax-vampnet/chignolin_modal/chignolin/replica_0/traj.dcd

vampnet fit nStates 2 lag 100 features ca_distances epochs 30

vampnet states
vampnet means
vampnet animate mode 1 nFrames 50
vampnet network
vampnet timescales taus 50,100,200,500
vampnet save /tmp/chignolin_vampnet.pkl
